<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Contact - Savanna Brew Café</title>
    <link rel="stylesheet" href="css/style.css">
</head>
<body>

<header>
    <h2>Savanna Brew Café ☕</h2>
    <nav>
        <a href="index.html">Home</a>
        <a href="about.html">About</a>
        <a href="menu.html">Menu</a>
        <a href="gallery.html">Gallery</a>
        <a href="contact.html">Contact</a>
    </nav>
</header>

<main class="welcome">
    <h1>Contact Us & Reservations</h1>

    <h2>Our Contact Details</h2>
    <p>Address: 14 Coffee Lane, Westlands, Nairobi</p>
    <p>Phone: +254 700 123 456</p>
    <p>Email: hello@savannabrew.example</p>
    <p>Instagram: @savannabrew</p>

    <h2>Opening Hours</h2>
    <table>
        <tr><th>Day</th><th>Hours</th></tr>
        <tr><td>Monday to Friday</td><td>7:00 AM - 9:00 PM</td></tr>
        <tr><td>Saturday</td><td>8:00 AM - 10:00 PM</td></tr>
        <tr><td>Sunday</td><td>9:00 AM - 6:00 PM</td></tr>
    </table>

    <h2>Book a Table</h2>

    <form action="#" method="post">

        <label for="name">Full Name:</label>
        <input type="text" id="name" name="name" required>

        <label for="email">Email:</label>
        <input type="email" id="email" name="email" required>

        <label for="phone">Phone:</label>
        <input type="tel" id="phone" name="phone">

        <label for="date">Reservation Date:</label>
        <input type="date" id="date" name="date" required>

        <label for="time">Reservation Time:</label>
        <input type="time" id="time" name="time" required>

        <label for="guests">Number of Guests:</label>
        <select id="guests" name="guests">
            <option>1</option>
            <option>2</option>
            <option>3</option>
            <option>4</option>
            <option>5</option>
            <option>6</option>
            <option>7</option>
            <option>8</option>
            <option>9</option>
            <option>10</option>
        </select>

        <fieldset>
            <legend>Occasion</legend>
            <label><input type="radio" name="occasion" value="Casual"> Casual</label>
            <label><input type="radio" name="occasion" value="Birthday"> Birthday</label>
            <label><input type="radio" name="occasion" value="Business"> Business</label>
        </fieldset>

        <label for="requests">Special Requests:</label>
        <textarea id="requests" name="requests"></textarea>

        <button type="submit">Submit Reservation</button>

    </form>
</main>

<footer>
    <p>14 Coffee Lane, Westlands, Nairobi</p>
    <p>© 2026 Savanna Brew Café. All rights reserved.</p>
</footer>

</body>
</html>
